<resources>
    <!-- Build properties from a GMS certified device against current platform SPL level -->
    <java-symbol type="array" name="config_certifiedBuildProperties" />

    <!-- These are system packages exempted from privacy indicator -->
    <java-symbol type="array" name="config_indicatorExemptedPackageNames" />

    <!-- Light / Regular style fonts -->
    <java-symbol type="string" name="config_lightFontFamily" />
    <java-symbol type="string" name="config_regularFontFamily" />

    <!-- Location indicator -->
    <java-symbol type="drawable" name="stat_sys_location" />

    <!-- Cycle through ringer modes -->
    <java-symbol type="string" name="volume_dialog_ringer_guidance_normal" />

    <!-- App error dialog -->
    <java-symbol type="id" name="aerr_copy" />
    <java-symbol type="string" name="url_copy_success" />
    <java-symbol type="string" name="url_copy_failed" />

    <!-- PowerOffAlarmService -->
    <java-symbol type="bool" name="config_powerOffAlarmEnabled" />
    <java-symbol type="string" name="notification_channel_poweroff_alarm" />
    <java-symbol type="string" name="poweroff_alarm_title" />
    <java-symbol type="string" name="poweroff_alarm_body" />
    <java-symbol type="drawable" name="ic_alarm_on" />

    <!-- Lock gesture -->
    <java-symbol type="string" name="gesture_locked_warning" />

    <!-- Whether to show edge light only when the device is face down by default -->
    <java-symbol type="bool" name="config_edgeLightFaceDownEnabledByDefault" />

    <!-- Vendor mismatch fingerprint warning -->
    <java-symbol type="string" name="system_error_vendorprint" />

    <!-- Whether or not we should show vendor mismatch message -->
    <java-symbol type="bool" name="config_show_vendor_mismatch_message" />
</resources>
